# cURL Command to Login User:
curl -X POST \
  http://127.0.0.1:8000/djangoapp/login \
  -H 'Content-Type: application/json' \
  -d '{
    "userName": "admin",
    "password": "adminpassword"
  }'

# Response Output:
HTTP/1.1 200 OK
Content-Type: application/json
Set-Cookie: sessionid=g3z4m9w1kp7r2qx5l8v0t1yn6sb4df8h; HttpOnly; Path=/; SameSite=Lax

{
  "userName": "admin",
  "status": "Authenticated"
}
